<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <activeProfiles>
    <activeProfile>github</activeProfile>
  </activeProfiles>
  <profiles>
    <profile>
      <id>github</id>
      <properties></properties>
      <repositories>
        <repository>
  <id>central</id>
  <url>https://repo.maven.apache.org/maven2/</url>
</repository>
<repository>
  <id>repo1</id>
  <url>https://repo1.maven.org/maven2/</url>
</repository>

        <repository>
          <id>mycompany-maven</id>
          <url>https://mycompany-123456789012.d.codeartifact.us-east-1.amazonaws.com/maven/maven/</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
  <id>central</id>
  <url>https://repo.maven.apache.org/maven2/</url>
</pluginRepository>
<pluginRepository>
  <id>repo1</id>
  <url>https://repo1.maven.org/maven2/</url>
</pluginRepository>

        <pluginRepository>
          <id>mycompany-maven</id>
          <url>https://mycompany-123456789012.d.codeartifact.us-east-1.amazonaws.com/maven/maven/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <servers>
    <server>
      <id>mycompany-maven</id>
      <username>aws</username>
      <password>fake-token</password>
    </server>
  </servers>
  <mirrors></mirrors>
  <pluginGroups></pluginGroups>
  <proxies></proxies>
</settings>
